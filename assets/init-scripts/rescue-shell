#!/bin/sh

# # # # # # # # # # # # # #
# minimal environment
export LANG=C
export LC_ALL=C
export TERM="${TERM:-linux}"	#export TERM=xterm-256color
export HOME=/root

mkdir -p -m 0700 "$HOME"

# # # # # # # # # # # # # #
# root shell
[ -n "$1" ] && printf '\n[\033[31mRESCUE\033[0m] %s\n\n' "$1" 1>&2

while true; do
	PS1='(initrd)\w\$ ' setsid cttyhack /bin/sh #-o vi
done
